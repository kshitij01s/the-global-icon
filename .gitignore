.DS_Store
Thumbs.db

# --- Development storage ---
# Directory structure is kept via .gitkeep and the small generated cover PNGs
# (storage/development-only/demo-pdf-covers) are committed. PDFs are NOT
# committed: copy the five supplied demo PDFs into
# storage/development-only/magazines/pdfs/supplied/ (see docs/SUPPLIED_PDFS.md).
storage/development-only/**/*.pdf
storage/development-only/uploads/**
!storage/development-only/uploads/.gitkeep
# Never commit production storage or private backups.
storage/production/
storage/backups/

apps/api/.superadmin-local.txt
apps/api/.env
node_modules/
dist/
*.local.txt
