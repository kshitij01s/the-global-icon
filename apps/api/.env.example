NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/the_global_icon?schema=public
# Production: use long random secrets (>= 32 chars); access and refresh must differ.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
STORAGE_ROOT=../../storage/development-only
# Production: only real HTTPS origins of the public site + admin console.
CORS_ORIGINS=http://localhost:5173,http://localhost:4200
SUPER_ADMIN_EMAIL=superadmin@example.test
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_USERNAME=superadmin

# Optional
# Public website origin used for absolute links in RSS (defaults to the first CORS origin).
# PUBLIC_SITE_URL=http://localhost:5173
# Production tips:
# - NODE_ENV=production
# - Put TLS in front of the API (nginx / Cloudflare / load balancer)
# - Point STORAGE_ROOT (or future object storage) at durable private PDF storage
# - Never commit real .env files
